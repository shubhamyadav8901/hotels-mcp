{
  "name": "india-hotels-mcp",
  "version": "0.2.0",
  "description": "MCP server for finding, comparing and planning hotel stays across India around stations, airports, landmarks and coordinates",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "hotels",
    "hotel-search",
    "india",
    "travel",
    "geocoding",
    "routing",
    "openstreetmap",
    "osrm",
    "irctc",
    "retiring-rooms",
    "stay-planning"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamyadav8901/hotels-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/shubhamyadav8901/hotels-mcp/issues"
  },
  "homepage": "https://github.com/shubhamyadav8901/hotels-mcp#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "build:data": "tsx scripts/build-data.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "docs:tools": "tsx scripts/gen-tool-docs.ts",
    "docs:check": "tsx scripts/gen-tool-docs.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
