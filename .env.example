# Required by the Nominatim usage policy: identify yourself (app name + contact).
HTTP_USER_AGENT=india-hotels-mcp/0.1 (you@example.com)

# Optional: Google Hotels via SerpApi (free tier 250 searches/month).
SERPAPI_KEY=

# Unofficial sources (currently Xotelo, an API derived from TripAdvisor meta-search) are off by default.
# Set to true only after checking the terms that apply to you (see DISCLAIMER.md).
ENABLE_UNOFFICIAL_SOURCES=false

# Comma-separated provider ids to turn off, e.g. xotelo,serpapi
PROVIDERS_DISABLED=

# Routing / geocoding endpoints (defaults are public instances; set OSRM_URL for self-hosted OSRM).
OSRM_URL=https://routing.openstreetmap.de/routed-car
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io

# Drive-time multipliers for traffic (OSM routing has no traffic data).
METRO_TRAFFIC_MULTIPLIER=1.5
OTHER_TRAFFIC_MULTIPLIER=1.2

# Itinerary buffers in minutes before a departure.
TRAIN_BUFFER_MIN=30
FLIGHT_BUFFER_MIN=120

# Per-search time limit for each source, in milliseconds.
PROVIDER_DEADLINE_MS=20000


# HTTP mode only. PORT (default 3001) and HOST (bind address, default 127.0.0.1) apply when running
# `npm start -- --http` or `docker run --env-file .env`. Under docker compose they are fixed by
# docker-compose.yml (port 3001, HOST=0.0.0.0 inside the container, published on 127.0.0.1 only), so
# setting them here has no effect there.
# PORT=3001
# HOST=127.0.0.1
# ALLOWED_HOSTS: extra hostnames accepted in the Host header, any port (DNS-rebinding protection).
# localhost, 127.0.0.1 and [::1] are always accepted. Add a tunnel hostname here if you use one.
# ALLOWED_HOSTS=my-tunnel.example.com
